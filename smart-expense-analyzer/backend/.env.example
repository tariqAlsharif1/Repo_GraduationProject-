# Copy this file to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://username:123456@localhost:5432/smart_expense_db

# CORS - the origin(s) of your React dev server
FRONTEND_ORIGIN=http://localhost:5173

# ML model paths (relative to backend/)
ML_MODEL_PATH=app/ml/expense_model.joblib
ML_VECTORIZER_PATH=app/ml/vectorizer.joblib

# Confidence threshold below which the keyword fallback is used instead of the ML prediction
ML_CONFIDENCE_THRESHOLD=0.55
